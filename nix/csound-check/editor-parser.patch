+/* Reset lexer state after Bison reports a malformed statement or header. */
+void csound_orc_recover(void *yyscanner) {
+  struct yyguts_t *yyg = (struct yyguts_t *)yyscanner;
+  PARM->paren_depth = 0;
+  if (strcmp(yytext, "opcode") && strcmp(yytext, "declare")) BEGIN(INITIAL);
+}
 
