{
    "region": "us-central1",
    "functions": [
        "delete_account",
        "fork_project",
        "popular_artists",
        "popular_projects",
        "random_projects",
        "search_projects",
        "search_users",
        "toggle_project_star"
    ],
    "hostingFunctions": ["host"],
    "role": "roles/run.invoker",
    "member": "allUsers",
    "environments": {
        "dev": {
            "firebaseAlias": "develop",
            "origins": [
                "https://csound-ide-dev.firebaseapp.com",
                "https://csound-ide-dev.web.app",
                "http://localhost:3000"
            ]
        },
        "prod": {
            "firebaseAlias": "default",
            "origins": [
                "https://ide.csound.com",
                "https://csound-ide.firebaseapp.com",
                "https://csound-ide.web.app"
            ]
        }
    },
    "hostingPaths": [
        "/",
        "/editor/__hosting_access_check__",
        "/profile/__hosting_access_check__"
    ]
}
