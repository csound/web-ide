{
    "firestore": {
        "indexes": "firestore.indexes.json"
    },
    "functions": {
        "runtime": "nodejs22",
        "source": "./functions"
    },
    "hosting": {
        "public": "dist",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "rewrites": [
            {
                "source": "/manual/**",
                "destination": "/manual/404.html"
            },
            {
                "source": "/",
                "function": "host"
            },
            {
                "source": "/editor/**",
                "function": "host"
            },
            {
                "source": "/profile/**",
                "function": "host"
            },
            {
                "source": "/documentation",
                "destination": "/index.html"
            },
            {
                "source": "/documentation/**",
                "destination": "/index.html"
            }
        ],
        "headers": [
            {
                "source": "/editor/**",
                "headers": [
                    {
                        "key": "Cross-Origin-Embedder-Policy",
                        "value": "require-corp"
                    },
                    {
                        "key": "Cross-Origin-Opener-Policy",
                        "value": "same-origin"
                    }
                ]
            },
            {
                "source": "**/*.@(jpg|svg|jpeg|png|eot|otf|ttf|ttc|woff|css|wasm|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "max-age=2592000,public,immutable"
                    }
                ]
            },
            {
                "source": "/manual/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public,max-age=0,must-revalidate"
                    },
                    {
                        "key": "Cross-Origin-Resource-Policy",
                        "value": "same-origin"
                    },
                    {
                        "key": "Cross-Origin-Embedder-Policy",
                        "value": "require-corp"
                    }
                ]
            }
        ]
    }
}
